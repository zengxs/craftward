# Absolute path to the Qt SDK installation prefix for the current platform.
# Example for macOS: /Volumes/Projects/Qt/6.11.1/macos
QT6_ROOT=/path/to/qt-sdk

# Optional Codex executable override for development and CI. If unset, the
# standalone CLI resolves `codex` through PATH.
# CRAFTWARD_CODEX_PATH=/absolute/path/to/codex

# macOS code-signing identity used by the deploy task. The default is ad hoc.
# Example: Developer ID Application: Example Company (TEAMID)
# SIGN_IDENTITY=-
