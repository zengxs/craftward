[binaries]
c = '@CMAKE_C_COMPILER@'
cpp = '@CMAKE_CXX_COMPILER@'
ar = '/usr/bin/ar'
strip = '/usr/bin/strip'
pkg-config = '@PKG_CONFIG_EXECUTABLE@'
[host_machine]
system = 'darwin'
cpu_family = '@cpu_family@'
cpu = '@arch@'
endian = 'little'
[properties]
needs_exe_wrapper = true
[built-in options]
c_args = ['-arch', '@arch@', '-isysroot', '@sdk@', '-mmacosx-version-min=@CMAKE_OSX_DEPLOYMENT_TARGET@']
cpp_args = ['-arch', '@arch@', '-isysroot', '@sdk@', '-mmacosx-version-min=@CMAKE_OSX_DEPLOYMENT_TARGET@']
c_link_args = ['-arch', '@arch@', '-isysroot', '@sdk@', '-mmacosx-version-min=@CMAKE_OSX_DEPLOYMENT_TARGET@']
cpp_link_args = ['-arch', '@arch@', '-isysroot', '@sdk@', '-mmacosx-version-min=@CMAKE_OSX_DEPLOYMENT_TARGET@']
