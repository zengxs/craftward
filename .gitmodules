[submodule "app/third_party/scintilla"]
	path = app/third_party/scintilla
	url = https://github.com/craftward/scintilla.git
	shallow = true
[submodule "core/ward-highlighting/assets/Packages"]
	path = core/ward-highlighting/assets/Packages
	url = https://github.com/sublimehq/Packages.git
[submodule "core/ward-highlighting/assets/QML"]
	path = core/ward-highlighting/assets/QML
	url = https://github.com/SublimeText/QML.git
[submodule "core/ward-highlighting/assets/INI"]
	path = core/ward-highlighting/assets/INI
	url = https://github.com/jwortmann/ini-syntax.git
[submodule "core/ward-highlighting/assets/Swift-Next"]
	path = core/ward-highlighting/assets/Swift-Next
	url = https://github.com/Swift-Next/Swift-Next.git
[submodule "core/ward-highlighting/assets/Zig"]
	path = core/ward-highlighting/assets/Zig
	url = https://github.com/craftward/sublime-zig-language.git
[submodule "core/ward-highlighting/assets/Protobuf"]
	path = core/ward-highlighting/assets/Protobuf
	url = https://github.com/VcamX/protobuf-syntax-highlighting.git
[submodule "core/ward-highlighting/assets/CMake"]
	path = core/ward-highlighting/assets/CMake
	url = https://github.com/zyxar/Sublime-CMakeLists.git
[submodule "app/third_party/contour"]
	path = app/third_party/contour
	url = https://github.com/craftward/contour.git
[submodule "app/third_party/libunicode"]
	path = app/third_party/libunicode
	url = https://github.com/contour-terminal/libunicode.git
[submodule "app/third_party/freetype"]
	path = app/third_party/freetype
	url = https://github.com/freetype/freetype.git
[submodule "app/third_party/harfbuzz"]
	path = app/third_party/harfbuzz
	url = https://github.com/harfbuzz/harfbuzz.git
[submodule "app/third_party/cairo"]
	path = app/third_party/cairo
	url = https://gitlab.freedesktop.org/cairo/cairo.git
[submodule "app/third_party/pixman"]
	path = app/third_party/pixman
	url = https://gitlab.freedesktop.org/pixman/pixman.git
[submodule "app/third_party/libpng"]
	path = app/third_party/libpng
	url = https://github.com/pnggroup/libpng.git
[submodule "app/third_party/yaml-cpp"]
	path = app/third_party/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "app/third_party/GSL"]
	path = app/third_party/GSL
	url = https://github.com/microsoft/GSL.git
[submodule "app/third_party/boxed-cpp"]
	path = app/third_party/boxed-cpp
	url = https://github.com/contour-terminal/boxed-cpp.git
[submodule "app/third_party/reflection-cpp"]
	path = app/third_party/reflection-cpp
	url = https://github.com/contour-terminal/reflection-cpp.git
